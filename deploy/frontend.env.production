# =============================================================================
# PF Space Frontend - Production Environment Variables
# =============================================================================
# VITE_API_URL     : URL backend publik (dipakai oleh frontend/src/lib/api.js)
# SEO_BACKEND_URL  : URL backend internal (untuk seoPlugin di vite.config.js saat build)
#                    Harus menunjuk langsung ke proses backend, BUKAN domain publik
#                    agar tidak terjadi loop request.
# =============================================================================
VITE_API_URL=https://yourdomain.com
SEO_BACKEND_URL=http://127.0.0.1:3001
