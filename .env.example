# =============================================================================
# PF Space - Docker Environment Configuration
# =============================================================================
# Salin file ini menjadi `.env` sebelum menjalankan `docker compose up -d`:
#   cp .env.example .env
# =============================================================================

# Port Eksternal Host
FRONTEND_PORT=80
BACKEND_PORT=3001
DB_PORT=3306
REDIS_PORT=6379

# Database MySQL
DB_NAME=si_film_archive
DB_USER=pfspace_user
DB_PASSWORD=pfspace_password_super_aman
DB_ROOT_PASSWORD=root_password_super_aman

# Better Auth (Minimal 32 karakter)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=ganti_dengan_random_string_minimal_32_karakter_ya
BETTER_AUTH_URL=http://localhost

# Frontend & CORS
FRONTEND_URL=http://localhost
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3001,http://localhost:80

# Auto Migrasi & Seed Admin
RUN_MIGRATIONS=true
RUN_SEED=true
ADMIN_EMAIL=admin@pfspace.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin PF Space

# Transcoder Worker Concurrency
TRANSCODER_CONCURRENCY=1

# Integrasi Eksternal (Opsional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
AI_PROVIDER=gemini

