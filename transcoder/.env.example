# =============================================================================
# PF Space - Transcoder Service Environment Configuration
# =============================================================================
# Salin file ini menjadi .env pada direktori /transcoder untuk mengkonfigurasi
# environment worker service.
# =============================================================================

# Node Environment ('development' | 'production')
NODE_ENV=development

# Database Connection (digunakan worker untuk update transcode_status)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=film

# Redis Server Connection (Queue Consumer)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# FFmpeg & FFprobe Executable Paths (Opsional)
# -----------------------------------------------------------------------------
# Kosongkan jika ffmpeg & ffprobe sudah terdaftar pada OS PATH sistem.
# 
# Contoh Windows Development (jika tidak ada di PATH):
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
#
# Contoh Linux Production (aaPanel / Ubuntu default):
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Transcoder Worker Settings
# Concurrency = Jumlah job video yang diproses secara simultan (Default: 1)
TRANSCODER_CONCURRENCY=1

# Upload Directory Override (Opsional)
# Kosongkan untuk menggunakan default path: ../backend/uploads
UPLOAD_DIR=
